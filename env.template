# llama-server-native configuration.
# Copy to .env once (`cp env.template .env`); docker compose reads it automatically.
# Every variable is optional: an empty or missing value falls back to the default shown here.

# =============================================================================
# Build settings: changing any of these requires a rebuild
#   docker compose build && docker compose up -d
# =============================================================================

# llama.cpp version to build. Also used as the image tag (llama-server-native:<ref>).
#   v0.7.0, v0.7.1…  stable releases (recommended)
#   b10786           build of a specific commit
#   master           latest commit
LLAMA_CPP_REF=v0.7.0

# Compute capability of your GPU. `docker build` cannot see the GPU, so it is set here.
#   nvidia-smi --query-gpu=name,compute_cap --format=csv,noheader
#   12.0 -> 120a-real   (the "a" suffix is for Blackwell and newer, cc >= 12.0)
#   8.9  -> 89-real     (RTX 4090)
# A wrong value is caught by the hardware guard at startup.
CUDA_ARCH=120a-real

# CUDA toolkit used to compile. Avoid 13.0 and 13.2 (known miscompilations, see README).
CUDA_VERSION=12.9.2
UBUNTU_VERSION=24.04
GCC_VERSION=14
NODE_VERSION=24

# =============================================================================
# Runtime settings: apply with `docker compose up -d`
# (`docker restart` does NOT re-read this file)
# =============================================================================

# GPU/CPU layer split. Keep "auto": a fixed number disables --fit, and a model that does
# not fit entirely in VRAM fails to load instead of being split.
N_GPU_LAYERS=auto

# MiB of VRAM left free for the desktop and other apps.
FIT_TARGET=1024

# Context per conversation (~12,000 words). Do not set 0 ("model's native context"):
# with 256k-context models the KV cache eats all the VRAM and the model ends up on CPU.
CTX_SIZE=16384

# 8-bit KV cache: half the VRAM of f16 with no noticeable quality loss.
# Quantized KV cache needs flash attention.
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0
FLASH_ATTN=auto

# Reuse the common prompt prefix between turns of a conversation.
CACHE_REUSE=256

# Web search tools (web_search, fetch_url) through the local SearXNG + MCP server.
# Enabled by default. Leave empty (WEB_SEARCH=) to disable.
WEB_SEARCH=/opt/llama/mcp.json

# Host port. Published on 127.0.0.1 only: llama-server has no authentication by default.
PORT=8080

# Models loaded at the same time. On a 16 GB GPU keep 1: two models compete for VRAM
# (measured: a 1.7B model dropped from 357 to 57 tok/s with a 27B also loaded).
MODELS_MAX=1

# CPU threads. -1 = auto.
THREADS=-1

# Any other llama-server flag, as is. See LAUNCH.md. Example:
#   EXTRA_ARGS=--metrics --reasoning-budget 2048
EXTRA_ARGS=

# Hugging Face token, only for private or gated repos.
HF_TOKEN=

# UID/GID the server runs as, so downloaded models belong to you and not to root.
LLAMA_UID=1000
LLAMA_GID=1000

# Set to 1 to start even if the hardware differs from the one the image was built for.
ALLOW_HW_MISMATCH=0
